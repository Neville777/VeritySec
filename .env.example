# VeritySec Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# AI Provider API Keys
# Set these and reference them in config.yaml channel headers via ${ENV_VAR} syntax
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Info Collection API Keys (used by the info-collect page)
FOFA_API_KEY=
ZOOMEYE_API_KEY=
QUAKE_API_KEY=
SHODAN_API_KEY=

# Encryption secret for user API keys (BYOK). Generate with: openssl rand -hex 32
VERITYSEC_SECRET_KEY=

# Email (Resend) — sends welcome emails when creating users
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@yourdomain.com
VERITYSEC_APP_URL=https://your-veritysec-instance.com

# Robot / Chatbot Tokens
TELEGRAM_BOT_TOKEN=
DINGTALK_BOT_TOKEN=
FEISHU_BOT_TOKEN=
WECHAT_BOT_TOKEN=
WECOM_SECRET=
