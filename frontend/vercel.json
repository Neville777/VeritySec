{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    { "src": "^/$", "dest": "/landing.html" },
    { "src": "^/app(/.*)?$", "dest": "/app.html" },
    { "src": "^/static/(.*)$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true }
  ]
}
